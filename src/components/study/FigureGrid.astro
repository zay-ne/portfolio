---
import type { FigureItem } from '../../data/study-types';

export interface Props {
  items: FigureItem[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<figure class="figures" data-reveal>
  <ol class="grid">
    {
      items.map((item, i) => (
        <li class="item" style={`--d:${i * 110}ms`}>
          <span class="value tabular">{item.value}</span>
          <span class="label-text">{item.label}</span>
          {item.source && <span class="label source">{item.source}</span>}
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .figures {
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Der Abstand zwischen den Feldern wird zur Trennlinie. */
    background: var(--color-line);
    border-block: 1px solid var(--color-line);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0;
    background: var(--color-bg);
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0);
  }

  html.js [data-reveal].is-visible .item {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms var(--ease-out-quart) var(--d),
      transform 700ms var(--ease-out-expo) var(--d);
  }

  html:not(.js) .item {
    opacity: 1;
    transform: none;
  }

  .value {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-accent);
  }

  .label-text {
    max-inline-size: 34ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-fg);
  }

  .source {
    color: var(--color-fg-subtle);
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .caption {
    padding-block-start: 1rem;
    max-inline-size: 60ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-fg-subtle);
  }

  @media (min-width: 40rem) {
    /* auto-fit statt fester Spaltenzahl, damit zwei, drei und vier Kennzahlen
       gleichermaßen sitzen. */
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }

    .item {
      padding: 2rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item {
      opacity: 1;
      transform: none;
    }
  }
</style>
