---
import LegalPage from '../layouts/LegalPage.astro';
import { SITE } from '../consts';
---

<LegalPage
  locale="de"
  altHref="/en/imprint"
  title="Impressum"
  lead="Die Pflichtangaben nach § 5 DDG werden gerade ergänzt."
>
  <h2>Kontakt</h2>
  <p>
    Bis die vollständigen Angaben hier stehen, erreichen Sie mich unter
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>

  <h2>Verantwortlich für den Inhalt</h2>
  <p>Schedi Samet</p>
</LegalPage>
