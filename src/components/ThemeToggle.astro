---
import Icon from './Icon.astro';
import { getLocale, t } from '../i18n/utils';

const locale = getLocale(Astro.url);
const strings = t(locale);
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label={strings.meta.themeToggle}>
  <span class="icon icon-sun"><Icon name="sun" size={16} /></span>
  <span class="icon icon-moon"><Icon name="moon" size={16} /></span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    /* Sichtbar 34px, Trefferfläche über das Pseudo-Element auf 44px erweitert. */
    position: relative;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart);
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: -5px;
  }

  .theme-toggle:hover {
    border-color: var(--color-fg);
  }

  .icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart);
  }

  /* Hell: Mond anbieten (Ziel), Sonne verbergen. Dunkel umgekehrt. */
  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .icon-moon {
    opacity: 1;
    transform: none;
  }

  :global([data-theme='dark']) .icon-sun {
    opacity: 1;
    transform: none;
  }

  :global([data-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
</style>
