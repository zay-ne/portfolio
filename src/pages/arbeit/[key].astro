---
import ProjectPage from '../../layouts/ProjectPage.astro';
import StudyPage from '../../layouts/StudyPage.astro';
import { projectPath } from '../../i18n/utils';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const [de, en] = await Promise.all([getProjects('de'), getProjects('en')]);
  const translated = new Set(en.map((p) => p.data.key));

  return de.map((project) => ({
    params: { key: project.data.key },
    props: {
      project,
      // Fehlt die Übersetzung, führt der Sprachumschalter zur englischen Startseite
      // statt in eine 404.
      altHref: translated.has(project.data.key) ? projectPath(project.data.key, 'en') : '/en/',
    },
  }));
}

const { project, altHref } = Astro.props;
---

{
  /* Arbeiten mit eigenem Layout bekommen ihre eigene Seite, alle anderen
     laufen über die Standard-Projektseite. */
  project.data.feature ? (
    <StudyPage locale="de" project={project} altHref={altHref} />
  ) : (
    <ProjectPage locale="de" project={project} altHref={altHref} />
  )
}
