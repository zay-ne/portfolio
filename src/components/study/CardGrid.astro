---
export interface Props {
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ol class="cards" data-count={items.length} data-reveal>
  {
    items.map((item, i) => (
      <li class="card" style={`--d:${i * 110}ms`}>
        <span class="num label">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="card-title">{item.title}</h3>
        <p class="card-body">{item.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-surface);
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0);
  }

  html.js [data-reveal].is-visible .card {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms var(--ease-out-quart) var(--d),
      transform 700ms var(--ease-out-expo) var(--d);
  }

  html:not(.js) .card {
    opacity: 1;
    transform: none;
  }

  .num {
    color: var(--color-accent);
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .card-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }

  @media (min-width: 56rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Vier Karten in drei Spalten lassen eine allein in der zweiten Zeile
       stehen. Zwei mal zwei sieht ruhiger aus. */
    .cards[data-count='2'],
    .cards[data-count='4'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .cards[data-count='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      opacity: 1;
      transform: none;
    }
  }
</style>
